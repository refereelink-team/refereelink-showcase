{
  "name": "refereelink-showcase",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "lint": "tsc -p web/tsconfig.json --noEmit",
    "preview": "vite preview --config web/vite.config.ts",
    "test": "node --experimental-strip-types --test web/tests/*.test.mts",
    "format:check": "prettier --check web/src web/vite.config.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "prettier": "^3.8.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
