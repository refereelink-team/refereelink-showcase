[Unit]
Description=RefereeLink focused CUDA showcase
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/refereelink-showcase
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/bash %h/refereelink-showcase/deploy/start-local.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillMode=control-group

[Install]
WantedBy=default.target
