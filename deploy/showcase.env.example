# Remote CUDA host only; replace paths with your deployment's actual values.
SHOWCASE_MEDIA_ROOT=/srv/refereelink-showcase/runtime/media
SHOWCASE_STATE_ROOT=/srv/refereelink-showcase/runtime/state
SHOWCASE_UPSTREAM=http://127.0.0.1:8000
SHOWCASE_CORE_ROOT=/srv/refereelink-showcase/backend_core
SHOWCASE_CORE_PYTHON=/srv/refereelink-showcase/.venv/bin/python
SHOWCASE_PLAYER_MODEL=/srv/refereelink-showcase/runtime/weights/yolo11s.pt
SHOWCASE_PITCH_MODEL=/srv/refereelink-showcase/runtime/weights/football-pitch-detection.pt
SHOWCASE_FOUL_MODEL=/srv/refereelink-showcase/runtime/weights/mvfoul.pth.tar
SHOWCASE_FOUL_CODE="/srv/refereelink-showcase/backend_core/third_party/sn-mvfoul/VARS model"
SHOWCASE_BUNDLE=/srv/refereelink-showcase/runtime/media/calibration/match-1.npz
# API default; the native foul demonstration always requires qualified mvit-contact-v3.
SHOWCASE_FOUL_PROFILE=legacy-v1
SHOWCASE_PREPARE_FOUL_ON_STARTUP=true
# Optional private qualification. Missing or invalid qualification blocks native preparation.
# SHOWCASE_FOUL_QUALIFICATION=/srv/refereelink-showcase/runtime/foul-qualification-v3.json
# Set SHOWCASE_FOUL_PROFILE=mvit-contact-v3 only after validating that qualification.
# Optional author MultiDimStacker comparison assets; these are not bundled with the repository.
# SHOWCASE_MULTIDIM_MODEL=/srv/refereelink-showcase/runtime/weights/author-model.pth.tar
# SHOWCASE_MULTIDIM_CODE=/srv/refereelink-showcase/runtime/external/multidim-source
