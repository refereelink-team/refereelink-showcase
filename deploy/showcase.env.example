# Optional overrides for deploy/start-local.sh on local WSL2/Linux CUDA.
# Copy to ignored deploy/showcase.env. Paths otherwise default to this checkout's
# runtime/ and backend_core/, using the backend's current Python interpreter.
# This file is sourced by Bash: use shell syntax and quote paths with spaces.
# No remote server, /srv path or private device identifier is required.
SHOWCASE_HOST=127.0.0.1
SHOWCASE_PORT=8010
SHOWCASE_UPSTREAM=http://127.0.0.1:8000

# Optional absolute paths when assets or Python are outside the checkout:
# SHOWCASE_PYTHON=/path/to/cuda-venv/bin/python
# SHOWCASE_MEDIA_ROOT=/path/to/runtime/media
# SHOWCASE_STATE_ROOT=/path/to/runtime/state
# SHOWCASE_CORE_PYTHON=/path/to/cuda-venv/bin/python
# SHOWCASE_PLAYER_MODEL=/path/to/runtime/weights/yolo11s.pt
# SHOWCASE_PITCH_MODEL=/path/to/runtime/weights/football-pitch-detection.pt
# SHOWCASE_FOUL_MODEL=/path/to/runtime/weights/mvfoul.pth.tar
# SHOWCASE_FOUL_CODE="/path/to/backend_core/third_party/sn-mvfoul/VARS model"
# SHOWCASE_BUNDLE=/path/to/runtime/media/calibration/match-1.npz

# API default; the native foul demonstration still requires qualified mvit-contact-v3.
SHOWCASE_FOUL_PROFILE=legacy-v1
SHOWCASE_PREPARE_FOUL_ON_STARTUP=true
# Missing or invalid private qualification blocks native foul preparation.
# SHOWCASE_FOUL_QUALIFICATION=/path/to/runtime/foul-qualification-v3.json
# Optional author MultiDimStacker comparison assets (not bundled):
# SHOWCASE_MULTIDIM_MODEL=/path/to/runtime/weights/author-model.pth.tar
# SHOWCASE_MULTIDIM_CODE=/path/to/runtime/external/multidim-source
